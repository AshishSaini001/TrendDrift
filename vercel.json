{
	"buildCommand": "node backend/scripts/build-frontend.js",
	"outputDirectory": "backend/dist",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cross-Origin-Opener-Policy",
					"value": "same-origin-allow-popups"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/api/(.*)",
			"destination": "/api/[...path]"
		},
		{
			"source": "/((?!api/).*)",
			"destination": "/index.html"
		}
	]
}
